# Copy to .env and fill in. .env is git-ignored.
DB_HOST=127.0.0.1
DB_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
DB_NAME=orudesk
DB_USERNAME=orudesk_app
DB_PASSWORD=change-me
SERVER_PORT=8080
# Optional: the first ADMIN, created at startup if both are set.
ORUDESK_ADMIN_EMAIL=admin@example.org
ORUDESK_ADMIN_PASSWORD=change-me
# Signs the JWT access tokens. At least 32 characters. Generate one with: openssl rand -base64 48
ORUDESK_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
# Optional: turns on two-factor sign-in. Encrypts authenticator app secrets. Generate with: openssl rand -base64 32
ORUDESK_MFA_KEY=
# Optional: other origins whose web pages may call the API (CORS), comma-separated. Leave empty when the
# web app is served from the same origin (the default setup).
ORUDESK_WEB_ALLOWED_ORIGINS=
# Optional: the secret Prometheus sends to read /actuator/prometheus (at least 32 characters). Empty: no metrics.
# Generate one with: openssl rand -hex 32
ORUDESK_METRICS_TOKEN=

# Optional: after this many failed logins for one email within the window, that email waits until the window ends.
# ORUDESK_LOGIN_MAX_FAILURES=5
# ORUDESK_LOGIN_WINDOW=15m
