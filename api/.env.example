# Copy to .env and fill in. .env is git-ignored.
DB_HOST=127.0.0.1
DB_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
DB_NAME=orudesk
DB_USERNAME=orudesk_app
DB_PASSWORD=change-me
SERVER_PORT=8080
# Optional: the first ADMIN, created at startup if both are set.
ORUDESK_ADMIN_EMAIL=admin@example.org
ORUDESK_ADMIN_PASSWORD=change-me
# Signs the JWT access tokens. At least 32 characters. Generate one with: openssl rand -base64 48
ORUDESK_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
