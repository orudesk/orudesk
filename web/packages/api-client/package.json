{
  "name": "@orudesk/api-client",
  "description": "A typed client for the Orudesk API, generated from its OpenAPI contract.",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orudesk/orudesk.git",
    "directory": "web/packages/api-client"
  },
  "homepage": "https://github.com/orudesk/orudesk/tree/main/web/packages/api-client#readme",
  "keywords": [
    "orudesk",
    "openapi",
    "client"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepack": "cp ../../../LICENSE .",
    "contract:sync": "cp ../../../api/apps/orudesk-standard/build/openapi/orudesk-standard.json openapi/orudesk-standard.json && pnpm generate",
    "generate": "openapi-typescript openapi/orudesk-standard.json --output src/generated/schema.ts && prettier --write src/generated",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
