# A demo of Orudesk with sample data: two schools, a clinic, three users and a dozen people.
#   docker compose --env-file docker/demo.env -f docker/compose.yaml --profile app up -d --build --wait
# then open http://localhost:8090 and log in as admin@demo.orudesk.org / demo-password.
#
# These values are public (they're in git): never use this file for a real installation.
DB_PASSWORD=demo-password
ORUDESK_JWT_SECRET=demo-only-secret-that-is-public-so-never-use-it-for-real
ORUDESK_ADMIN_EMAIL=admin@demo.orudesk.org
ORUDESK_ADMIN_PASSWORD=demo-password
ORUDESK_PROFILES=demo
ORUDESK_METRICS_TOKEN=demo-metrics-token-public-never-use-for-real
